# Runtime variables use Nuxt's NUXT_* naming so they can safely be supplied
# after the production image has been built.
# PostgreSQL development database. Never point local development at production.
NUXT_DATABASE_URL=postgresql://billing:billing@localhost:5432/billing

# Generate with: openssl rand -base64 32
NUXT_BETTER_AUTH_SECRET=
NUXT_BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated extra production origins accepted by Better Auth.
BETTER_AUTH_TRUSTED_ORIGINS=
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_PUBLIC_COMPANY_NAME=Billing Infra
NUXT_PUBLIC_COMPANY_EMAIL=billing@example.test
NUXT_PUBLIC_BILLING_TIMEZONE=Asia/Makassar
# Optional. Defaults to package.json version.
# NUXT_PUBLIC_APP_VERSION=1.0.0
# NUXT_PUBLIC_APP_REVISION=

# Optional dedicated AES-256-GCM key for PostgreSQL cluster and service credentials.
# Falls back to NUXT_BETTER_AUTH_SECRET.
NUXT_INFRA_CREDENTIALS_KEY=
# Shared bearer secret used by CI to register an immutable image release.
# Generate with: openssl rand -base64 32
NUXT_RELEASE_WEBHOOK_SECRET=

# Directory containing oc-agent-linux-amd64 and/or oc-agent-linux-arm64.
# Build artifacts with: npm run agent:build:linux
NUXT_AGENT_ARTIFACT_DIRECTORY=dist
# Must match the version embedded in the published agent binary.
NUXT_AGENT_RELEASE_VERSION=0.11.0
NUXT_NODE_DISK_WARNING_PERCENT=80
NUXT_NODE_DISK_CRITICAL_PERCENT=90
NUXT_OPERATION_STUCK_MINUTES=15
# Pinned Traefik image installed by OC Agent during node enrollment.
NUXT_INFRASTRUCTURE_GATEWAY_IMAGE=traefik:v3.7.14
# Optional URL reachable by Ubuntu nodes on a development LAN.
# Example: http://10.5.80.141:3000 (installer adds --allow-insecure-http).
NUXT_PUBLIC_AGENT_CONTROL_PLANE_URL=

# Domain provisioning. Platform domains use <slug>.<platform-domain>.
NUXT_PLATFORM_DOMAIN=ocnetworks.web.id
# Required for Cloudflare for SaaS and/or Infrastructure -> Tunnels.
# Custom domains: Zone / SSL and Certificates / Write.
# Tunnel page: Account / Cloudflare Tunnel / Read; use Write to manage routes.
# Add Zone / DNS / Edit so BillEngine can point platform hostnames at the same
# tunnel target as DNS wildcard *.platform-domain.
NUXT_CLOUDFLARE_API_TOKEN=
NUXT_CLOUDFLARE_ZONE_ID=
# Account ID is required by the Tunnel page, but not by Custom Hostnames.
NUXT_CLOUDFLARE_ACCOUNT_ID=
NUXT_CLOUDFLARE_SAAS_CNAME_TARGET=cname.ocnetworks.web.id
NUXT_CLOUDFLARE_FALLBACK_ORIGIN=origin-apps.ocnetworks.web.id

# Transactional invoice email (Resend).
NUXT_RESEND_API_KEY=
NUXT_EMAIL_FROM=Billing Infra <billing@example.com>

# Optional bearer token required by /api/metrics. Strongly recommended in production.
NUXT_METRICS_TOKEN=

NUXT_COMPANY_NAME=Billing Infra
NUXT_COMPANY_EMAIL=billing@example.test
NUXT_COMPANY_ADDRESS=
NUXT_COMPANY_TAX_ID=
NUXT_BILLING_TIMEZONE=Asia/Makassar
NUXT_BILLING_CURRENCY=IDR
# Fractional tax rate: 0.11 means 11%.
NUXT_BILLING_DEFAULT_TAX_RATE=
# Enables recurring invoice generation. Keep disabled until services are ready.
NUXT_BILLING_AUTOMATION_ENABLED=false

# Billing access gate. Keep disabled until the Traefik ForwardAuth middleware is installed.
NUXT_BILLING_ACCESS_CONTROL_ENABLED=false
# Whole calendar days after the due date during which browser users may continue.
NUXT_OVERDUE_GRACE_DAYS=7
# How long a visitor acknowledgement suppresses the grace notice.
NUXT_GRACE_NOTICE_INTERVAL_HOURS=24
# Generate both independently with: openssl rand -base64 32
NUXT_BILLING_GATE_SECRET=
NUXT_BILLING_GATE_SHARED_KEY=
# Address reachable from Traefik on every enrolled node.
# Example: https://panel.example.com/api/billing-gate/check
NUXT_BILLING_GATE_INTERNAL_URL=
