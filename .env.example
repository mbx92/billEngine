# PostgreSQL development database. Never point local development at production.
DATABASE_URL=postgresql://billing:billing@localhost:5432/billing

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated extra production origins accepted by Better Auth.
BETTER_AUTH_TRUSTED_ORIGINS=
APP_URL=http://localhost:3000

# Server-only Coolify credentials. Never prefix the token with NUXT_PUBLIC_.
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
# Optional dedicated key for encrypting tokens added through the UI.
# Falls back to BETTER_AUTH_SECRET when omitted.
COOLIFY_CREDENTIALS_KEY=

COMPANY_NAME=Billing Infra
COMPANY_EMAIL=billing@example.test
COMPANY_ADDRESS=
COMPANY_TAX_ID=
BILLING_TIMEZONE=Asia/Makassar
BILLING_CURRENCY=IDR
# Fractional tax rate: 0.11 means 11%.
BILLING_DEFAULT_TAX_RATE=
# Enables recurring invoice generation. Keep disabled until services are ready.
BILLING_AUTOMATION_ENABLED=false
