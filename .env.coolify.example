# Untuk compose.coolify.yaml: salin ke Environment Variables di Coolify.
# File .env.coolify lokal berisi nilai asli dan tidak masuk Git/image Docker.
# Gunakan database bill_engine_coolify yang sudah ada; jangan reset/seed ulang.
NUXT_DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/bill_engine_coolify

# Domain publik aplikasi BillEngine yang dipasang di Coolify.
NUXT_BETTER_AUTH_URL=https://billengine.ocnetworks.web.id
NUXT_PUBLIC_APP_URL=https://billengine.ocnetworks.web.id
NUXT_PUBLIC_COMPANY_NAME=OC Networks Billing
# Pertahankan secret/kunci lama agar kredensial Coolify di database tetap terbaca.
NUXT_BETTER_AUTH_SECRET=
NUXT_COOLIFY_CREDENTIALS_KEY=
NUXT_METRICS_TOKEN=

# Koneksi Coolify dan pengaturan perusahaan sudah disimpan dalam database.
# Nilai Settings tersimpan mengalahkan default billing dari env ini.
NUXT_BILLING_TIMEZONE=Asia/Makassar
NUXT_BILLING_CURRENCY=IDR
NUXT_BILLING_AUTOMATION_ENABLED=false
NUXT_BILLING_ACCESS_CONTROL_ENABLED=false
NUXT_OVERDUE_GRACE_DAYS=7
NUXT_GRACE_NOTICE_INTERVAL_HOURS=24

# Pertahankan secret gate lama. Shared key harus sama dengan billing-gate.yaml.
NUXT_BILLING_GATE_SECRET=
NUXT_BILLING_GATE_SHARED_KEY=
# APP_PORT adalah port host, bukan port container (container memakai 3000).
# Berlaku jika BillEngine dan proxy berada di host Coolify yang sama.
APP_PORT=8010
NUXT_BILLING_GATE_INTERNAL_URL=http://host.docker.internal:8010/api/billing-gate/check
